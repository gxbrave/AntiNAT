{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gxbrave/AntiNAT/evidence/v1",
  "title": "AntiNAT machine-readable evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan",
    "commit_sha",
    "command",
    "result",
    "artifact_digest",
    "os",
    "timeout"
  ],
  "properties": {
    "schema_version": {
      "const": "antinat.evidence/v1"
    },
    "plan": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3,
      "pattern": "^P[0-9]{2}$"
    },
    "commit_sha": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "result": {
      "type": "string",
      "enum": ["PASS", "SUPPORTED_WITH_LIMITS", "NO_GO", "FAIL"]
    },
    "artifact_digest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "os": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "timeout": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?!0000-)[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[Tt]([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]([.][0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?!0000-)[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[Tt]([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]([.][0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "summary": {
      "type": "string"
    },
    "evidence_paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
    }
  }
}
