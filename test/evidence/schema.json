{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gxbrave/AntiNAT/evidence/v1",
  "title": "AntiNAT machine-readable evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan",
    "commit_sha",
    "command",
    "result",
    "artifact_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "antinat.evidence/v1"
    },
    "plan": {
      "type": "string",
      "pattern": "^P[0-9]{2}$"
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "type": "string",
      "enum": ["PASS", "SUPPORTED_WITH_LIMITS", "NO_GO", "FAIL"]
    },
    "artifact_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string"
    },
    "evidence_paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
