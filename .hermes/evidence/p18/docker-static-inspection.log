implementation_sha=16d42de79c1412ef76848af50299097717176750
implementation_tree_sha=783efd504d51863a01deb2cedbe11a00411a5f09
command=set -eu
for image in antinat:p18-agent antinat:p18-controller; do
    docker image inspect "$image" --format "{{json .Config.User}}" | jq -e ".[0:5] == \"65532\"" >/dev/null
    docker image inspect "$image" --format "{{json .Config.Volumes}}" | jq -e "has(\"/var/lib/antinat\") and has(\"/var/log/antinat\")" >/dev/null
done
docker image inspect antinat:p18-agent --format "{{json .Config.Entrypoint}}" | jq -e ".[0] == \"/opt/antinat/bin/stage-enrollment\"" >/dev/null
docker image inspect antinat:p18-controller --format "{{json .Config.Entrypoint}}" | jq -e ".[0] == \"/opt/antinat/bin/antinat-controller\"" >/dev/null
docker image inspect antinat:p18-agent --format "{{json .Config.Healthcheck.Test}}" | jq -e "join(\" \") | contains(\"healthcheck-agent\")" >/dev/null
docker image inspect antinat:p18-controller --format "{{json .Config.Healthcheck.Test}}" | jq -e "join(\" \") | contains(\"/readyz\")" >/dev/null
printf "%s\n" "static-runtime-inspection: PASS"

static-runtime-inspection: PASS

exit_code=0
